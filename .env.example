# === Instagram Authentication ===
# Instaloader (default provider) - uses your IG session
IG_USERNAME=
IG_PASSWORD=
# Multiple sessions for rotation (comma-separated user:pass pairs)
IG_SESSIONS=user1:pass1,user2:pass2

# Apify (alternative provider)
APIFY_API_KEY=

# === Proxy Configuration ===
# Residential proxy URLs (comma-separated for rotation)
# Supports Bright Data, Smartproxy, Oxylabs formats
PROXY_URLS=
# Example: http://user:pass@gate.smartproxy.com:7000,http://user:pass@brd.superproxy.io:22225

# === Output Paths ===
OUTPUT_DIR=./output
DB_PATH=./output/pipeline.db
LOG_PATH=./output/logs/pipeline.log

# === Rate Limiting ===
# Min/max delay between requests in seconds
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=7.0
# Max requests per second for Instagram
IG_MAX_RPS=0.4

# === Data Retention ===
# Auto-purge entries older than this many days (0 = disabled)
RETENTION_DAYS=90
